# Copy the names you need into the host environment or into data/local.secrets.env.
# Put real values only in that copy. Do not commit a filled-in file.

# Required. At least 32 random bytes. The server refuses to start when this is missing.
JWT_SECRET=replace-with-at-least-32-random-bytes

# Required. At least 32 random bytes. Encrypts authenticator secrets at rest.
TOTP_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

# Desktop H2 only. At least 12 characters. Not a known default.
BAYPORT_DB_PASSWORD=replace-with-at-least-12-characters

# Shared clinic database (MySQL 8). Workstations never use these; only the server does.
SERVER_URL=http://192.168.1.10:8080
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/bayport_db
SPRING_DATASOURCE_USERNAME=bayport_app
SPRING_DATASOURCE_PASSWORD=replace-with-at-least-12-characters

# Used only when the database has no staff accounts. First login must change this password.
BAYPORT_ADMIN_USER=clinicadmin
BAYPORT_ADMIN_PASSWORD=replace-with-at-least-10-characters
BAYPORT_ADMIN_EMAIL=admin@example.com

# Mail. Leave blank until the clinic mailbox is ready. See data/mail.env.example.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# SMS. Leave disabled until a provider is chosen.
BAYPORT_SMS_ENABLED=false
BAYPORT_SMS_PROVIDER=semaphore
BAYPORT_SMS_API_KEY=
BAYPORT_SMS_API_SECRET=
BAYPORT_SMS_SENDER=Bayport
BAYPORT_SMS_ACCOUNT_SID=
BAYPORT_SMS_ENDPOINT=

# Optional. Access tokens last 8 hours.
JWT_EXPIRATION=28800000
SPRING_WEB_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Optional backup encryption. Leave blank to store archives unencrypted.
BACKUP_ENCRYPTION_KEY=

# Optional web-push keys. Unused until notification approval is turned on.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Clinic server profile. See deploy/clinic/bayport.env.example.
# SPRING_PROFILES_ACTIVE=production
# BAYPORT_SSL_ENABLED=true
# BAYPORT_SERVER_PORT=8443
# BAYPORT_ALLOW_LAN_HTTP=false
# BAYPORT_FRONTEND_DIR=C:\Bayport\app\web
# BAYPORT_UPLOAD_DIR=C:\Bayport\data\uploads
# BAYPORT_BACKUP_DIR=C:\Bayport\backups
# SERVER_SSL_KEY_STORE=file:C:/Bayport/config/bayport.p12
# SERVER_SSL_KEY_STORE_PASSWORD=replace-with-keystore-password
# SERVER_SSL_KEY_STORE_TYPE=PKCS12
# SERVER_SSL_KEY_ALIAS=bayport

# Bayport clinic environment. Copy to C:\Bayport\config\bayport.env
# Put real values only in that copy. Do not commit it.

SPRING_PROFILES_ACTIVE=production
JAVA_HOME=C:\Program Files\Java\jdk-17

# Address other clinic computers use. Placeholder only.
SERVER_URL=http://192.168.1.10:8080

# MySQL on this PC only. Do not open port 3306 to the network.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/bayport_db
SPRING_DATASOURCE_USERNAME=bayport_app
SPRING_DATASOURCE_PASSWORD=replace-with-at-least-12-characters

JWT_SECRET=replace-with-at-least-32-random-bytes
TOTP_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

# First administrator. Required only when the database has no staff accounts.
BAYPORT_ADMIN_USER=clinicadmin
BAYPORT_ADMIN_PASSWORD=replace-with-at-least-10-characters
BAYPORT_ADMIN_EMAIL=admin@example.com

# Pages and uploads live outside the git folder.
BAYPORT_FRONTEND_DIR=C:\Bayport\app\web
BAYPORT_UPLOAD_DIR=C:\Bayport\data\uploads
BAYPORT_LOG_FILE=C:\Bayport\logs\bayport.log
BAYPORT_BACKUP_DIR=C:\Bayport\backups
BAYPORT_BACKUP_KEEP=14
BAYPORT_BACKUP_CRON=0 15 2 * * *
# Optional second copy, for example an external drive. Leave blank to skip.
BAYPORT_BACKUP_EXTERNAL_DIR=
# Empty database used only to prove a backup can be restored. Must not be bayport_db.
BAYPORT_BACKUP_VERIFY_DATABASE=bayport_restore_check
# Optional. Leave blank to store backup archives unencrypted.
BACKUP_ENCRYPTION_KEY=
# Optional web-push keys. Unused until notification approval is turned on.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
BAYPORT_MYSQLDUMP=
BAYPORT_MYSQL=

# Staff browsers. Use the clinic PC name. No * and no file://.
SPRING_WEB_CORS_ALLOWED_ORIGINS=https://CLINIC-PC:8443

# HTTPS. new-local-cert.ps1 fills the SERVER_SSL_* lines.
BAYPORT_SSL_ENABLED=false
BAYPORT_SERVER_PORT=8080
# Set this to true only for a private clinic network before the certificate is installed.
BAYPORT_ALLOW_LAN_HTTP=false

# SERVER_SSL_KEY_STORE=file:C:/Bayport/config/bayport.p12
# SERVER_SSL_KEY_STORE_PASSWORD=replace-with-keystore-password
# SERVER_SSL_KEY_STORE_TYPE=PKCS12
# SERVER_SSL_KEY_ALIAS=bayport

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
BAYPORT_SMS_ENABLED=false
BAYPORT_SMS_API_KEY=
